    "stability.delay_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS delivers MetricKit diagnostics in batches about once a day, so a crash that just happened won't be here yet. Simulators rarely report at all."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKitの診断は、iOSが1日1回ほどまとめて送信します。いま起きたクラッシュはまだここにありません。シミュレータではほとんど届きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit 진단은 iOS가 하루 한 번꼴로 묶어서 보내요. 방금 난 크래시는 여기 없어요. 시뮬레이터에서는 거의 올라오지 않아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS delivers MetricKit diagnostics in batches about once a day, so a crash that just happened won't be here yet. Simulators rarely report at all."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 大约每天打包发送一次 MetricKit 诊断，所以刚发生的崩溃还看不到。模拟器上几乎不会上报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 大約每天一次將 MetricKit 診斷資料打包傳送，因此剛發生的當機這裡還看不到。模擬器幾乎不會回報。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS присылает диагностику MetricKit пакетами примерно раз в сутки, поэтому только что случившегося сбоя здесь ещё нет. С симулятора данные почти не приходят."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS entrega los diagnósticos de MetricKit por lotes, más o menos una vez al día, así que un fallo reciente aún no aparecerá aquí. Los simuladores casi nunca informan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS liefert MetricKit-Diagnosen gebündelt etwa einmal am Tag, ein gerade aufgetretener Absturz ist also noch nicht hier. Simulatoren melden kaum etwas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS envoie les diagnostics MetricKit par lots, environ une fois par jour : un plantage tout juste survenu n’apparaît pas encore. Les simulateurs en remontent rarement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS invia le diagnostiche MetricKit a gruppi, circa una volta al giorno, quindi un crash appena avvenuto non sarà ancora qui. I simulatori quasi non ne segnalano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS entrega os diagnósticos do MetricKit em lotes, cerca de uma vez por dia, então um travamento recente ainda não aparece aqui. Simuladores quase nunca reportam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ส่งผลวินิจฉัย MetricKit เป็นชุดประมาณวันละครั้ง แครชที่เพิ่งเกิดจึงยังไม่อยู่ที่นี่ และบนซิมูเลเตอร์แทบไม่มีรายงานเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS gửi chẩn đoán MetricKit theo lô, khoảng một lần mỗi ngày, nên lỗi vừa xảy ra sẽ chưa có ở đây. Trình giả lập hầu như không báo cáo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doručuje diagnostiku MetricKit v dávkách zhruba jednou denně, takže pád, který se právě stal, tu ještě nebude. Simulátory hlásí jen zřídka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS leverer MetricKit-diagnostik i bunker omkring én gang om dagen, så et nedbrud, der lige er sket, er der ikke endnu. Simulatorer rapporterer sjældent overhovedet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iOS παραδίδει τα διαγνωστικά MetricKit σε παρτίδες περίπου μία φορά την ημέρα, οπότε ένα crash που μόλις έγινε δεν θα φαίνεται ακόμη. Οι προσομοιωτές σπάνια στέλνουν αναφορές."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS toimittaa MetricKit-diagnostiikan erissä noin kerran päivässä, joten juuri tapahtunutta kaatumista ei vielä näy. Simulaattorit raportoivat harvoin lainkaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mengirim diagnostik MetricKit secara berkelompok sekitar sehari sekali, jadi mogok yang baru terjadi belum akan muncul. Simulator jarang melaporkan sama sekali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS leverer MetricKit-diagnostikk i grupper omtrent én gang i døgnet, så et krasj som nettopp har skjedd, er ikke her ennå. Simulatorer rapporterer sjelden i det hele tatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS levert MetricKit-diagnostiek ongeveer eens per dag in bundels aan, dus een crash van zojuist staat hier nog niet. Simulators rapporteren zelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS wysyła diagnostykę MetricKit w paczkach mniej więcej raz dziennie, więc świeżej awarii tu jeszcze nie ma. Symulatory prawie nic nie zgłaszają."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS levererar MetricKit-diagnostik i omgångar ungefär en gång per dygn, så en krasch som nyss inträffat syns inte här än. Simulatorer rapporterar sällan alls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, MetricKit tanılarını günde bir kez toplu olarak gönderir; bu yüzden az önce olan bir çökme henüz burada olmaz. Simülatörler ise neredeyse hiç rapor göndermez."
          }
        }
      }
    },

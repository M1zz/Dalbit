    "whats_new.moon.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The moon is now a 3D sphere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

    "onboarding.p1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You try rain, switch to waves, go looking for something else — and the hour you meant to sleep is gone. Dalbit exists to take that search away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨音をかけてみて、波の音に変えて、また別の音を探しているうちに、眠るはずの時間が過ぎていた。そんな経験はありませんか。Dalbitは、その「探す時間」をなくすために生まれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빗소리를 켜 보고, 파도로 바꿔 보고, 다시 다른 걸 찾다가 정작 잠들 시간을 놓친 적 있으신가요. 달빛은 그 찾는 시간을 없애려고 만들었어요."
          }
        }
      }
    },
    "onboarding.p1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't spend the night\nlooking for a sound"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音探しで\n夜を終わらせないために"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리를 찾다가\n밤을 보내지 않도록"
          }
        }
      }
    },
    "onboarding.p2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water drops over rain, piano over that. Set each volume and how often the drops fall, save it once — and from the next night on it's a single tap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨音の上に水滴を、その上にピアノを。それぞれの音量や水滴が落ちる間隔まで整えて保存しておけば、次の夜からはワンタップで流せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빗소리 위에 물방울을, 그 위에 피아노를. 각각의 볼륨과 떨어지는 간격까지 맞춰 저장해 두면, 다음 밤부터는 한 번만 누르면 돼요."
          }
        }
      }
    },
    "onboarding.p2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layer them\ninto your own"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重ねて\n自分だけの音に"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "겹쳐서\n내 소리로 만들어요"
          }
        }
      }
    },
    "onboarding.p3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sleep timer doesn't cut out — it fades away. And because nobody closes an app after falling asleep, the sound keeps going even when the screen is off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープタイマーは時間が来ても音をぷつりと切らず、ゆっくりと小さくしていきます。眠ったらアプリを閉じないことを知っているから、画面を閉じても音は流れ続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 타이머는 시간이 되면 뚝 끊지 않고 천천히 잦아들어요. 잠들면 앱을 끄지 않는다는 걸 알기에, 화면을 덮어도 소리는 이어집니다."
          }
        }
      }
    },
    "onboarding.p3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built for after\nyou fall asleep"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠ったあとのことまで\n考えて作りました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠든 뒤를\n생각해서 만들었어요"
          }
        }
      }
    },
    "onboarding.p4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the moon, swipe it, press and hold. We'll show you exactly how, right after this."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の真ん中の月をタップしたり、スワイプしたり、長押ししたりしてみてください。使い方はこのあとすぐにご案内します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 가운데 달을 누르고, 밀고, 지그시 눌러 보세요. 어떻게 쓰는지는 바로 이어서 알려드릴게요."
          }
        }
      }
    },
    "onboarding.p4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One moon does\nall of it"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月ひとつで\nすべてできます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달 하나로\n다 됩니다"
          }
        }
      }
    },

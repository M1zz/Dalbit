        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se aplikace při vytváření zvuku zavře, vaše výběry a hlasitosti zůstanou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

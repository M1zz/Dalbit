    },
    "whats_new.moon.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can see its craters as it slowly turns and drifts across the night sky."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クレーターが見え、ゆっくり自転しながら夜空を漂います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분화구가 보이고, 아주 천천히 자전하며 밤하늘을 떠다녀요."
          }
        }
      }
    },
    "whats_new.dim.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The screen dims when left alone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触らずにいると画面が暗くなります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가만히 두면 화면이 어두워져요"
          }
        }
      }
    },
    "whats_new.dim.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fades gently so it won’t glare while you fall asleep, and brightens again at a touch. You can turn it off under Display in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠りにつくあいだまぶしくないよう少しずつ暗くなり、触れると元に戻ります。設定の「画面」でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠드는 동안 눈부시지 않게 서서히 어두워지고, 만지면 다시 밝아져요. 설정의 화면에서 끌 수 있어요."
          }
        }
      }
    },
    "whats_new.comfort.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follows your Accessibility settings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティ設定に合わせます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 설정을 따라요"
          }
        }
      }
    },
    "whats_new.comfort.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, the stars and comets hold still. Increase Contrast and Reduce Transparency make text and panels easier to read."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」をオンにすると星や彗星が止まり、「コントラストを上げる」「透明度を下げる」で文字と背景がくっきりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 줄이기를 켜면 별과 혜성이 멈추고, 대비 증가와 투명도 줄이기를 켜면 글자와 배경이 또렷해져요."
          }
        }
      }
    },

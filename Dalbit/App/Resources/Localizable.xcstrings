    "roadmap.autosave.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app closes while you’re making a sound, your picks and volumes are still there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウンドを作っている途中でアプリが閉じても、選んだ音や音量はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리를 만들다 앱이 꺼져도 고르던 소리와 볼륨이 그대로 남아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app closes while you’re making a sound, your picks and volumes are still there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制作声音时即使应用被关闭，选好的声音和音量也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "製作聲音時就算 App 被關閉，選好的聲音與音量也會保留。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если приложение закроется во время создания звука, выбранные звуки и громкость сохранятся."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la app se cierra mientras creas un sonido, tus elecciones y volúmenes siguen ahí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird die App beim Erstellen eines Sounds beendet, bleiben deine Auswahl und Lautstärken erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app se ferme pendant que vous créez un son, vos choix et vos volumes sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’app si chiude mentre crei un suono, le tue scelte e i volumi restano al loro posto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

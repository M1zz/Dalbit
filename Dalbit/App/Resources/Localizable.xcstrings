    "stats.rhythm_footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Active” counts listening, not merely opening the app — so these numbers differ from the retention card, which counts launches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アクティブ」はアプリを開いたことではなく、サウンドを**聴いた**ことを数えます。継続率カード(起動ベース)と数字が違うのは正常です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘활성’은 앱을 연 게 아니라 소리를 **들은** 것을 셉니다. 리텐션 카드(앱 실행 기준)와 숫자가 다른 게 정상이에요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Active” counts listening, not merely opening the app — so these numbers differ from the retention card, which counts launches."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“活跃”统计的是**收听**声音，而不是打开应用。所以与按启动次数统计的留存卡片数字不同是正常的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「活躍」計算的是有**收聽**，而不是開啟 App。所以數字與留存率卡片（以啟動為準）不同是正常的。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Активные» считаются по прослушиванию, а не по запуску приложения, поэтому числа отличаются от карточки удержания (по запускам) — это нормально."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Activo» cuenta a quien **escucha**, no a quien solo abre la app, así que estas cifras difieren de la tarjeta de retención, que cuenta aperturas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aktiv“ zählt das Hören, nicht das bloße Öffnen der App – deshalb weichen die Zahlen von der Retention-Karte ab, die Starts zählt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Actif » compte l’écoute, pas l’ouverture de l’app : les chiffres diffèrent donc de la carte de rétention, qui compte les lancements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Attivo” conta chi ha ascoltato, non chi ha solo aperto l’app: per questo i numeri differiscono dalla scheda di fidelizzazione, che conta le aperture."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ativo” conta quem ouviu, não quem só abriu o app. Por isso os números diferem do cartão de retenção, que conta aberturas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ใช้งาน” นับการ **ฟัง** ไม่ใช่แค่เปิดแอป ตัวเลขจึงต่างจากการ์ดรีเทนชันที่นับการเปิดแอป ซึ่งเป็นเรื่องปกติ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hoạt động” tính việc đã **nghe**, không chỉ là mở ứng dụng. Vì vậy con số khác với thẻ tỷ lệ quay lại (tính theo lượt mở) là bình thường."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aktivní“ znamená poslech, ne pouhé otevření aplikace, proto se čísla liší od karty retence, která počítá spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Aktiv” tæller lytning, ikke blot at åbne appen – så tallene afviger fra fastholdelseskortet, som tæller opstarter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «ενεργός» μετρά ακρόαση και όχι απλώς άνοιγμα της εφαρμογής, γι' αυτό οι αριθμοί διαφέρουν από την κάρτα διατήρησης, που μετρά εκκινήσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Aktiivinen” laskee kuuntelun, ei pelkkää sovelluksen avaamista, joten luvut eroavat säilyvyyskortista, joka laskee käynnistykset."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aktif” menghitung mendengarkan, bukan sekadar membuka aplikasi — jadi angkanya berbeda dari kartu retensi, yang menghitung peluncuran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Aktiv» teller at man **har lyttet**, ikke bare at appen åpnes – så tallene avviker fra retensjonskortet, som teller oppstarter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Actief” telt luisteren, niet alleen het openen van de app. Daarom wijken deze cijfers af van de retentiekaart, die starts telt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aktywni” to osoby, które słuchały, a nie tylko otworzyły aplikację, dlatego liczby różnią się od karty retencji, która liczy uruchomienia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Aktiv” räknar lyssning, inte bara att appen öppnats – så siffrorna skiljer sig från retentionskortet, som räknar starter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aktif”, uygulamayı açmayı değil sesi **dinlemeyi** sayar. Bu yüzden rakamlar, açılışları sayan elde tutma kartından farklı çıkabilir; bu normaldir."
          }
        }
      }
    },

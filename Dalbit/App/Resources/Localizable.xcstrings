    "whats_new.comfort.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, the stars and comets hold still. Increase Contrast and Reduce Transparency make text and panels easier to read."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」をオンにすると星や彗星が止まり、「コントラストを上げる」「透明度を下げる」で文字と背景がくっきりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 줄이기를 켜면 별과 혜성이 멈추고, 대비 증가와 투명도 줄이기를 켜면 글자와 배경이 또렷해져요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, the stars and comets hold still. Increase Contrast and Reduce Transparency make text and panels easier to read."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“减弱动态效果”后，星星和彗星会静止；开启“增强对比度”和“降低透明度”后，文字和背景会更清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「減少動態效果」後，星星與彗星會靜止；開啟「提高對比」與「降低透明度」後，文字與背景會更清楚。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С включённым «Уменьшением движения» звёзды и кометы замирают, а «Повышенный контраст» и «Уменьшение прозрачности» делают текст и панели чётче."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Reducir movimiento» activado, las estrellas y los cometas se quedan quietos. «Aumentar contraste» y «Reducir transparencia» hacen que el texto y los paneles se vean mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Bewegung reduzieren“ stehen Sterne und Kometen still. „Kontrast erhöhen“ und „Transparenz reduzieren“ machen Text und Flächen besser lesbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Réduire les animations, les étoiles et les comètes restent immobiles. Augmenter le contraste et Réduire la transparence rendent textes et panneaux plus lisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Riduci movimento attivo, stelle e comete restano ferme. Aumenta contrasto e Riduci trasparenza rendono testi e pannelli più leggibili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Reduzir Movimento ativado, estrelas e cometas ficam parados. Aumentar Contraste e Reduzir Transparência deixam textos e painéis mais fáceis de ler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดลดการเคลื่อนไหว ดาวและดาวหางจะหยุดนิ่ง และเมื่อเปิดเพิ่มคอนทราสต์กับลดความโปร่งใส ตัวอักษรและพื้นหลังจะอ่านง่ายขึ้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật Giảm chuyển động, sao và sao chổi sẽ đứng yên. Tăng độ tương phản và Giảm độ trong suốt giúp chữ và nền dễ đọc hơn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se zapnutým Omezením pohybu hvězdy a komety zůstanou stát. Zvýšený kontrast a Omezení průhlednosti zpřehlední text i panely."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Reducer bevægelse er slået til, står stjerner og kometer stille. Øg kontrast og Reducer gennemsigtighed gør tekst og paneler lettere at læse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργή τη Μείωση κίνησης, τα αστέρια και οι κομήτες μένουν ακίνητοι. Η Αύξηση αντίθεσης και η Μείωση διαφάνειας κάνουν το κείμενο και τα πάνελ πιο ευανάγνωστα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Vähennä liikettä on päällä, tähdet ja komeetat pysyvät paikallaan. Lisää kontrastia ja Vähennä läpinäkyvyyttä tekevät tekstistä ja paneeleista selkeämpiä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Kurangi Gerakan aktif, bintang dan komet diam. Tingkatkan Kontras dan Kurangi Transparansi membuat teks dan panel lebih mudah dibaca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Reduser bevegelse på står stjerner og kometer stille. Øk kontrast og Reduser gjennomsiktighet gjør tekst og flater lettere å lese."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Verminder beweging aan blijven de sterren en kometen stil. Verhoog contrast en Verminder transparantie maken tekst en vlakken beter leesbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu ograniczenia ruchu gwiazdy i komety się zatrzymują, a zwiększony kontrast i ograniczenie przezroczystości poprawiają czytelność tekstu i paneli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Minska rörelser på står stjärnorna och kometerna stilla. Öka kontrast och Minska transparens gör text och paneler tydligare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareketi Azalt açıkken yıldızlar ve kuyruklu yıldızlar durur; Kontrastı Artır ve Saydamlığı Azalt ise yazıları ve panelleri daha net yapar."
          }
        }
      }
    },

    "recap.entry_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The nights you've spent with Dalbit"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달빛과 보낸 밤을 모아 봤어요"
          }
        }
      }
    },
    "recap.estimate_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nights you likely drifted off” counts nights when the sleep timer ran to the end, or the sound kept playing for over 30 minutes. It's an estimate, not a sleep measurement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘잠든 것 같은 밤’은 수면 타이머를 끝까지 두었거나 30분 넘게 틀어 둔 밤이에요. 실제 수면을 측정한 값은 아니에요."
          }
        }
      }
    },
    "recap.feedback_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One line is enough — what works, or what doesn't."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘 맞는 소리든 아쉬운 점이든, 한 줄이면 충분해요."
          }
        }
      }
    },
    "recap.feedback_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is Dalbit helping you sleep?"

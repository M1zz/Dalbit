    "tip.effects_off.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe down to the Library, open Settings (gear) at the top right, and turn off effects to hear background music only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にスワイプしてライブラリを開き、右上の設定(歯車)で効果音をオフにすると、BGMだけを聴けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 스와이프해 보관함 오른쪽 위 설정(톱니)에서 효과음을 끄면 배경음악만 들을 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe down to the Library, open Settings (gear) at the top right, and turn off effects to hear background music only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下滑打开声音库，在右上角的设置（齿轮）里关闭音效，就只会听到背景音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "往下滑開啟聲音庫，在右上角的設定（齒輪）中關閉音效，就能只聽背景音樂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вниз, откройте «Настройки» (шестерёнка) в правом верхнем углу библиотеки и отключите эффекты — останется только фоновая музыка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia abajo hasta la biblioteca, abre Ajustes (el engranaje) arriba a la derecha y desactiva los efectos para oír solo la música de fondo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach unten zur Bibliothek, öffne oben rechts die Einstellungen (Zahnrad) und schalte die Effekte aus, um nur Hintergrundmusik zu hören."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez vers le bas pour ouvrir la bibliothèque, touchez Réglages (l’engrenage) en haut à droite et désactivez les effets pour n’entendre que la musique de fond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso il basso fino alla libreria, apri Impostazioni (ingranaggio) in alto a destra e disattiva gli effetti per ascoltare solo la musica di sottofondo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para baixo até a biblioteca, abra os Ajustes (engrenagem) no canto superior direito e desative os efeitos para ouvir só a música de fundo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดลงเพื่อเปิดคลังเสียง แล้วไปที่การตั้งค่า (เฟือง) มุมขวาบน ปิดเสียงเอฟเฟกต์ก็จะได้ยินแต่ดนตรีพื้นหลัง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt xuống để mở Thư viện, vào Cài đặt (bánh răng) ở góc trên bên phải rồi tắt hiệu ứng để chỉ nghe nhạc nền."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeďte dolů do knihovny, vpravo nahoře otevřete Nastavení (ozubené kolo) a vypněte efekty – uslyšíte jen hudbu na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg ned til biblioteket, åbn Indstillinger (tandhjulet) øverst til højre, og slå effektlyde fra for kun at høre baggrundsmusik."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε προς τα κάτω στη Βιβλιοθήκη, ανοίξτε τις Ρυθμίσεις (γρανάζι) πάνω δεξιά και απενεργοποιήστε τα εφέ για να ακούτε μόνο μουσική υποβάθρου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise alas kirjastoon, avaa oikean yläkulman asetukset (hammasratas) ja poista tehosteet käytöstä, niin kuuluu vain taustamusiikki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke bawah ke Pustaka, buka Pengaturan (roda gigi) di kanan atas, lalu matikan efek untuk mendengar musik latar saja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip ned til biblioteket, åpne Innstillinger (tannhjulet) øverst til høyre, og slå av effektlyder for å høre bare bakgrunnsmusikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omlaag naar de bibliotheek, open Instellingen (tandwiel) rechtsboven en zet effecten uit om alleen achtergrondmuziek te horen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w dół do biblioteki, otwórz Ustawienia (koło zębate) w prawym górnym rogu i wyłącz efekty, aby słyszeć tylko muzykę w tle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep nedåt till biblioteket, öppna Inställningar (kugghjulet) uppe till höger och stäng av effektljud för att bara höra bakgrundsmusik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağı kaydırıp Kitaplık'ı açın, sağ üstteki Ayarlar'dan (dişli) efektleri kapatın; yalnızca arka plan müziğini dinlersiniz."
          }
        }
      }
    },

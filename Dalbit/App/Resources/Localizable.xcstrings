        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달빛이 도움이 되고 있나요?"
          }
        }
      }
    },
    "recap.local_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

    "recap.estimate_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nights you likely drifted off” counts nights when the sleep timer ran to the end, or the sound kept playing for over 30 minutes. It's an estimate, not a sleep measurement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「眠れたらしい夜」は、スリープタイマーを最後まで使った夜か、30分以上サウンドを流した夜です。実際の睡眠を測定した値ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘잠든 것 같은 밤’은 수면 타이머를 끝까지 두었거나 30분 넘게 틀어 둔 밤이에요. 실제 수면을 측정한 값은 아니에요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nights you likely drifted off” counts nights when the sleep timer ran to the end, or the sound kept playing for over 30 minutes. It's an estimate, not a sleep measurement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“似乎睡着的夜晚”是指睡眠定时走完全程，或声音播放超过 30 分钟的夜晚。这只是估算，并非实际测量的睡眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「疑似睡著的夜晚」是指睡眠計時器跑到最後，或聲音持續播放超過 30 分鐘的夜晚。這並非實際測量的睡眠數據。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ночи, когда вы, вероятно, уснули» — это ночи, когда таймер сна дошёл до конца или звук играл дольше 30 минут. Это оценка, а не измерение сна."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las «noches en que probablemente te dormiste» son aquellas en que el temporizador de sueño llegó al final o el sonido siguió más de 30 minutos. Es una estimación, no una medición del sueño."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nächte, in denen du wohl eingeschlafen bist“ zählt Nächte, in denen der Schlaf-Timer bis zum Ende lief oder der Sound über 30 Minuten spielte. Das ist eine Schätzung, keine Schlafmessung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nuits d’endormissement probable » compte les nuits où le minuteur est allé au bout, ou où le son a joué plus de 30 minutes. C’est une estimation, pas une mesure du sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le “notti in cui forse ti sei addormentato” sono quelle in cui il timer del sonno è arrivato alla fine o il suono è rimasto in riproduzione per più di 30 minuti. È una stima, non una misurazione del sonno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Noites em que você provavelmente dormiu” são as noites em que o timer de sono foi até o fim ou o som tocou por mais de 30 minutos. É uma estimativa, não uma medição do sono."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“คืนที่น่าจะหลับ” คือคืนที่ปล่อยให้ตัวตั้งเวลานอนทำงานจนจบ หรือเปิดเสียงไว้นานกว่า 30 นาที ไม่ใช่ค่าที่วัดการนอนจริง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Đêm có thể bạn đã ngủ” là những đêm hẹn giờ ngủ chạy đến hết, hoặc âm thanh phát hơn 30 phút. Đây là ước tính, không phải số liệu đo giấc ngủ thực tế."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezi „noci, kdy jste pravděpodobně usnuli“ se počítají noci, kdy časovač spánku doběhl do konce nebo zvuk hrál déle než 30 minut. Jde o odhad, ne o měření spánku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Nætter, hvor du nok faldt i søvn” tæller de nætter, hvor søvntimeren løb helt ud, eller lyden spillede i over 30 minutter. Det er et skøn, ikke en søvnmåling."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι «νύχτες που πιθανόν αποκοιμηθήκατε» μετρούν τις νύχτες που το χρονόμετρο ύπνου έτρεξε μέχρι το τέλος ή ο ήχος συνέχισε πάνω από 30 λεπτά. Είναι εκτίμηση, όχι μέτρηση του ύπνου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Yöt, jolloin luultavasti nukahdit” tarkoittaa öitä, jolloin uniajastin kävi loppuun tai ääni soi yli 30 minuuttia. Se on arvio, ei unen mittaus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Malam kamu mungkin tertidur” menghitung malam saat timer tidur berjalan sampai selesai, atau suara terus diputar lebih dari 30 menit. Ini perkiraan, bukan pengukuran tidur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Netter du trolig sovnet» er netter der søvntimeren gikk helt ut, eller lyden spilte i over 30 minutter. Det er et anslag, ikke en søvnmåling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij “Nachten dat je waarschijnlijk insliep” tellen nachten waarin de slaaptimer helemaal afliep of het geluid langer dan 30 minuten bleef spelen. Het is een schatting, geen slaapmeting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Noce z prawdopodobnym zaśnięciem” to noce, gdy wyłącznik czasowy dotrwał do końca albo dźwięk grał ponad 30 minut. To szacunek, a nie pomiar snu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Nätter du troligen somnade” är nätter då sovtimern gick till slutet eller ljudet spelades i över 30 minuter. Det är en uppskattning, inte en sömnmätning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uyuduğunuz düşünülen geceler”, uyku zamanlayıcısının sonuna kadar çalıştığı ya da sesin 30 dakikadan uzun süre açık kaldığı geceleri sayar. Bu bir tahmindir, gerçek bir uyku ölçümü değildir."
          }
        }
      }
    },

    "onboarding.p1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You try rain, switch to waves, go looking for something else — and the hour you meant to sleep is gone. Dalbit exists to take that search away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨音をかけてみて、波の音に変えて、また別の音を探しているうちに、眠るはずの時間が過ぎていた。そんな経験はありませんか。Dalbitは、その「探す時間」をなくすために生まれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빗소리를 켜 보고, 파도로 바꿔 보고, 다시 다른 걸 찾다가 정작 잠들 시간을 놓친 적 있으신가요. 달빛은 그 찾는 시간을 없애려고 만들었어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You try rain, switch to waves, go looking for something else — and the hour you meant to sleep is gone. Dalbit exists to take that search away."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试雨声，换成海浪，又去找别的……本该入睡的时间就这样溜走了，你是不是也有过？Dalbit 就是为了省下这段寻找的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試了雨聲，換成海浪，又繼續找別的，結果錯過了原本該睡覺的時間，你是不是也有過這樣的經驗？Dalbit 就是為了省下這段尋找的時間而生。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включили дождь, потом волны, потом ещё что-то — и время для сна незаметно ушло. Dalbit создан, чтобы вам больше не приходилось искать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebas la lluvia, cambias a las olas, sigues buscando otra cosa… y la hora de dormir se te escapa. Dalbit existe para ahorrarte esa búsqueda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Regen, dann Wellen, dann wieder etwas anderes – und schon ist die Zeit zum Einschlafen vorbei. Dalbit gibt es, damit du nicht mehr suchen musst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous essayez la pluie, puis les vagues, vous cherchez autre chose, et l’heure où vous deviez dormir est passée. Dalbit est faite pour mettre fin à cette recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provi la pioggia, passi alle onde, ne cerchi un’altra ancora, e intanto l’ora in cui volevi dormire è sfumata. Dalbit nasce per togliere di mezzo questa ricerca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você testa a chuva, troca pelas ondas, sai procurando outra coisa, e a hora de dormir passa. O Dalbit existe para acabar com essa busca."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเสียงฝน สลับเป็นคลื่นทะเล แล้วไปหาอย่างอื่นต่อ จนเลยเวลานอนไปเสียแล้ว เคยเป็นไหม Dalbit สร้างมาเพื่อตัดเวลาที่ใช้ตามหาเสียงนั้นออกไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã bao giờ bật thử tiếng mưa, đổi sang tiếng sóng, rồi lại đi tìm thứ khác, và cứ thế lỡ mất giờ đi ngủ chưa? Dalbit ra đời để bạn không phải mất công tìm kiếm ấy nữa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustíte déšť, přepnete na vlny, hledáte dál a čas, kdy jste chtěli spát, je pryč. Dalbit vznikl, aby tohle hledání zmizelo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du prøver regn, skifter til bølger, leder efter noget helt tredje – og den time, du ville bruge på at sove, er væk. Dalbit findes for at tage den leden fra dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάζετε βροχή, αλλάζετε σε κύματα, ψάχνετε κάτι άλλο και η ώρα που θέλατε να κοιμηθείτε πάει χαμένη. Το Dalbit υπάρχει για να σας γλιτώσει από αυτό το ψάξιμο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeilet sadetta, vaihdat aaltoihin, etsit taas jotain muuta – ja nukkumaanmenoaika meni jo. Dalbit on tehty poistamaan tuo etsiminen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mencoba hujan, ganti ke ombak, lalu mencari yang lain — dan jam tidurmu pun lewat. Dalbit hadir untuk menghapus pencarian itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du prøver regn, bytter til bølger, leter videre – og timen du skulle sove i, er borte. Dalbit er laget for at du slipper å lete."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je probeert regen, schakelt naar golven, zoekt nog iets anders en het uur waarop je wilde slapen is voorbij. Dalbit is er om dat zoeken weg te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączasz deszcz, zmieniasz na fale, szukasz czegoś innego i nagle czas na sen już minął. Dalbit powstał, by skończyć z tym szukaniem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du provar regn, byter till vågor, letar efter något annat – och timmen då du skulle sova är borta. Dalbit finns för att ta bort det letandet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yağmuru açtınız, dalgalara geçtiniz, derken başka bir şey aramaya koyuldunuz; uyuyacağınız saat de geçip gitti. Dalbit, bu aramayı ortadan kaldırmak için yapıldı."
          }
        }
      }
    },
    "onboarding.p1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't spend the night\nlooking for a sound"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音探しで\n夜を終わらせないために"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리를 찾다가\n밤을 보내지 않도록"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't spend the night\nlooking for a sound"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别再为找声音\n熬掉一整晚"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別再為了找聲音\n耗掉一整晚"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не тратьте ночь\nна поиск звука"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que buscar un sonido\nno te robe la noche"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbring die Nacht nicht\nmit der Suche nach einem Sound"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne passez plus la nuit\nà chercher un son"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non passare la notte\na cercare un suono"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não passe a noite\nprocurando um som"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าให้ทั้งคืนหมดไป\nกับการหาเสียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng thức cả đêm\nđể tìm một âm thanh"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ať noc nestrávíte\nhledáním zvuku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug ikke natten\npå at lede efter en lyd"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην περνάτε τη νύχτα\nψάχνοντας έναν ήχο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä vietä yötä\netsimällä ääntä"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan habiskan malam\nuntuk mencari suara"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk ikke natten\npå å lete etter en lyd"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek niet de hele nacht\nnaar een geluid"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie spędzaj nocy\nna szukaniu dźwięku"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slösa inte natten\npå att leta efter ljud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses ararken\ngeceyi kaçırmayın"
          }
        }
      }
    },
    "onboarding.p2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water drops over rain, piano over that. Set each volume and how often the drops fall, save it once — and from the next night on it's a single tap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨音の上に水滴を、その上にピアノを。それぞれの音量や水滴が落ちる間隔まで整えて保存しておけば、次の夜からはワンタップで流せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빗소리 위에 물방울을, 그 위에 피아노를. 각각의 볼륨과 떨어지는 간격까지 맞춰 저장해 두면, 다음 밤부터는 한 번만 누르면 돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water drops over rain, piano over that. Set each volume and how often the drops fall, save it once — and from the next night on it's a single tap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨声上叠水滴声，再叠上钢琴。把每一层的音量、水滴落下的间隔都调好并存下来，之后的夜晚只需点一下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨聲上疊水滴聲，再疊上鋼琴。連各自的音量與水滴落下的間隔都調好存起來，從下一個夜晚起，只要點一下。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Капли воды поверх дождя, поверх них — пианино. Настройте громкость каждого слоя и частоту капель, сохраните один раз — и со следующей ночи хватит одного касания."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotas de agua sobre la lluvia, piano sobre todo eso. Ajusta el volumen de cada una y cada cuánto caen las gotas, guárdalo una vez y, desde la noche siguiente, bastará un toque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wassertropfen über Regen, Klavier darüber. Stell Lautstärke und Tropfenabstand ein, speichere den Mix einmal – und ab der nächsten Nacht genügt ein Tipp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des gouttes d’eau sur la pluie, du piano par-dessus. Réglez chaque volume et l’intervalle des gouttes, enregistrez une fois : dès la nuit suivante, un seul toucher suffit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gocce d’acqua sulla pioggia, e sopra ancora il pianoforte. Regola il volume di ciascuno e ogni quanto cadono le gocce, salva una volta sola, e dalla sera dopo basta un tocco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotas d’água sobre a chuva, piano por cima. Ajuste o volume de cada um e o intervalo das gotas, salve uma vez e, a partir da noite seguinte, basta um toque."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงฝน ซ้อนด้วยหยดน้ำ แล้วซ้อนด้วยเปียโน ปรับระดับเสียงของแต่ละชั้นและจังหวะที่หยดน้ำตกลงมา บันทึกไว้ครั้งเดียว คืนต่อไปก็แตะเดียวเท่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếng giọt nước phủ lên tiếng mưa, rồi thêm piano lên trên. Chỉnh âm lượng từng lớp và nhịp rơi của giọt nước, lưu lại một lần, từ đêm sau bạn chỉ cần chạm một cái."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na déšť kapky vody, na ně klavír. Nastavte hlasitost každého zvuku i to, jak často kapky padají, uložte to jednou a od příští noci stačí jedno klepnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanddråber over regn, klaver over det hele. Indstil lydstyrke og hvor ofte dråberne falder, gem det én gang – og fra næste aften er det ét enkelt tryk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταγόνες νερού πάνω στη βροχή, πιάνο από πάνω. Ρυθμίστε την ένταση του καθενός και πόσο συχνά πέφτουν οι σταγόνες, αποθηκεύστε το μία φορά και από την επόμενη νύχτα αρκεί ένα πάτημα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisaroita sateen päälle, pianoa niiden päälle. Säädä kunkin voimakkuus ja pisaroiden tahti, tallenna kerran – ja ensi yöstä alkaen riittää yksi napautus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetesan air di atas hujan, lalu piano di atasnya. Atur volume dan seberapa sering tetesan jatuh, simpan sekali — dan mulai malam berikutnya cukup satu ketukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanndråper over regnet, piano over det igjen. Still inn volumet og hvor ofte dråpene faller, lagre én gang – så er det ett trykk fra neste natt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waterdruppels over regen, daaroverheen piano. Stel elk volume in en hoe vaak de druppels vallen, bewaar het één keer en vanaf de volgende nacht is het één tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krople wody na deszczu, a na nich pianino. Ustaw głośność każdej warstwy i odstępy między kroplami, zapisz raz, a od następnej nocy wystarczy jedno stuknięcie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vattendroppar över regnet, piano över det. Ställ in varje volym och hur ofta dropparna faller, spara en gång – och från nästa kväll räcker ett tryck."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yağmurun üstüne su damlaları, onun üstüne piyano. Her sesin seviyesini ve damlaların düşme aralığını ayarlayıp bir kez kaydedin; ertesi geceden itibaren tek dokunuş yeter."
          }
        }
      }
    },
    "onboarding.p2.title" : {
      "extractionState" : "manual",
      "localizations" : {

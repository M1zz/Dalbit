        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างมาเพื่อ\nช่วงที่คุณหลับไปแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm ra cho\nlúc bạn đã ngủ"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořeno pro chvíli,\nkdy už spíte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavet til tiden\nefter du er faldet i søvn"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιαγμένο για τη στιγμή\nπου θα αποκοιμηθείτε"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehty sitä\nhetkeä varten, kun nukahdat"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuat untuk saat\nkamu sudah terlelap"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laget for tiden\netter at du sovner"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemaakt voor het moment\nnadat je slaapt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomyślany\no tym, co po zaśnięciu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjord för tiden\nefter att du somnat"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyuduktan sonrası\ndüşünülerek yapıldı"
          }
        }
      }
    },
    "onboarding.p4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the moon, swipe it, press and hold. We'll show you exactly how, right after this."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の真ん中の月をタップしたり、スワイプしたり、長押ししたりしてみてください。使い方はこのあとすぐにご案内します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 가운데 달을 누르고, 밀고, 지그시 눌러 보세요. 어떻게 쓰는지는 바로 이어서 알려드릴게요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the moon, swipe it, press and hold. We'll show you exactly how, right after this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试在屏幕中央的月亮上点一点、滑一滑、长按一下。具体怎么用，接下来马上告诉你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試著對畫面中央的月亮點一下、滑一滑、長按看看。接下來馬上為你示範怎麼用。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь луны в центре экрана, смахните её, нажмите и удержите. Как это работает, покажем сразу после этого экрана."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la luna en el centro de la pantalla, deslízala, mantenla pulsada. Enseguida te enseñamos cómo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Mond, wische darüber, halte ihn gedrückt. Wie genau, zeigen wir dir gleich im Anschluss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la lune, faites-la glisser, maintenez le doigt dessus. On vous montre comment juste après."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la luna, scorrila, tienila premuta. Subito dopo ti mostreremo come si fa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque na lua, deslize, mantenha pressionada. Já já mostramos como, logo depois desta tela."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ ปัด หรือกดดวงจันทร์กลางหน้าจอค้างไว้ดูสิ เดี๋ยวจะบอกวิธีใช้ต่อจากนี้เลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chạm, vuốt và nhấn giữ mặt trăng ở giữa màn hình. Ngay sau đây chúng tôi sẽ chỉ bạn cách dùng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na měsíc uprostřed obrazovky, přejeďte po něm prstem nebo ho dlouze stiskněte. Jak přesně, ukážeme vám hned potom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på månen, stryg den, og tryk og hold. Vi viser dig præcis hvordan lige efter dette."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το φεγγάρι, σύρετέ το, κρατήστε το πατημένο. Αμέσως μετά θα σας δείξουμε ακριβώς πώς."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta kuuta keskellä näyttöä, pyyhkäise sitä ja paina pitkään. Näytämme heti tämän jälkeen, miten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk bulan, geser, tekan lama. Kami akan tunjukkan caranya tepat setelah ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på månen midt på skjermen, sveip den, trykk og hold. Vi viser deg nøyaktig hvordan rett etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de maan, veeg erover, houd hem ingedrukt. We laten je zo precies zien hoe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij księżyc na środku ekranu, przesuń go albo przytrzymaj. Zaraz pokażemy, jak to działa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på månen, svep, håll nere. Vi visar hur direkt efter det här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın ortasındaki Ay'a dokunun, kaydırın, basılı tutun. Nasıl kullanılacağını hemen ardından göstereceğiz."
          }
        }
      }
    },

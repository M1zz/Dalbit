        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ้อนเสียงกัน\nเป็นเสียงของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xếp chồng thành\nâm thanh của riêng bạn"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrstvěte zvuky\na vytvořte si svůj"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg dem i lag\ntil din egen lyd"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε τους σε στρώματα\nκαι φτιάξτε τον δικό σας"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerrosta äänet\nomaksi yhdistelmäksesi"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumpuk jadi\nsuaramu sendiri"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg dem i lag\ntil din egen lyd"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg ze over elkaar\ntot jouw geluid"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nałóż warstwy\ni stwórz własny dźwięk"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg ljuden i lager\ntill ditt eget"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katmanlayın,\nkendi sesiniz olsun"
          }
        }
      }
    },
    "onboarding.p3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sleep timer doesn't cut out — it fades away. And because nobody closes an app after falling asleep, the sound keeps going even when the screen is off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープタイマーは時間が来ても音をぷつりと切らず、ゆっくりと小さくしていきます。眠ったらアプリを閉じないことを知っているから、画面を閉じても音は流れ続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 타이머는 시간이 되면 뚝 끊지 않고 천천히 잦아들어요. 잠들면 앱을 끄지 않는다는 걸 알기에, 화면을 덮어도 소리는 이어집니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sleep timer doesn't cut out — it fades away. And because nobody closes an app after falling asleep, the sound keeps going even when the screen is off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠定时到点时不会戛然而止，而是慢慢淡出。我们知道没人会在睡着后关应用，所以就算屏幕熄灭，声音也会继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠計時器時間一到，不會戛然而止，而是慢慢淡出。因為知道睡著後沒人會關掉 App，所以就算螢幕蓋上，聲音也會繼續播放。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймер сна не обрывает звук, а плавно затихает. А поскольку во сне приложения никто не закрывает, звук продолжается и при выключенном экране."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El temporizador de sueño no corta el sonido: lo va apagando poco a poco. Y como nadie cierra una app al dormirse, el sonido sigue aunque la pantalla se apague."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf-Timer schneidet nichts ab, er blendet aus. Und weil im Schlaf niemand die App schließt, läuft der Sound auch bei ausgeschaltetem Bildschirm weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minuteur de sommeil ne coupe pas net : il s’estompe. Et comme personne ne ferme une app en s’endormant, le son continue même écran éteint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer del sonno non taglia di netto: sfuma piano. E poiché nessuno chiude un’app dopo essersi addormentato, il suono continua anche a schermo spento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O timer de sono não corta o som de repente: ele vai sumindo aos poucos. E, como ninguém fecha o app depois de dormir, o som continua mesmo com a tela apagada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวตั้งเวลานอนไม่ตัดเสียงฉับพลัน แต่ค่อย ๆ เบาลงจนเงียบ และเพราะไม่มีใครปิดแอปตอนหลับ ปิดหน้าจอแล้วเสียงก็ยังเล่นต่อ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hẹn giờ ngủ không tắt phụt khi hết giờ mà nhỏ dần rồi dừng. Vì ngủ rồi thì ai còn tắt ứng dụng, nên âm thanh vẫn tiếp tục dù màn hình đã tắt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovač spánku zvuk neutne, ale pozvolna utlumí. A protože ve spánku aplikaci nikdo nezavírá, zvuk hraje dál i při zhasnutém displeji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvntimeren afbryder ikke brat – lyden toner ud. Og fordi ingen lukker en app, efter de er faldet i søvn, spiller lyden videre, også når skærmen er slukket."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χρονόμετρο ύπνου δεν κόβει τον ήχο, τον σβήνει σταδιακά. Και επειδή κανείς δεν κλείνει εφαρμογές αφού αποκοιμηθεί, ο ήχος συνεχίζει ακόμα και με σβηστή οθόνη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniajastin ei katkaise ääntä, vaan se vaimenee hiljalleen. Koska kukaan ei sulje sovellusta nukahdettuaan, ääni jatkuu, vaikka näyttö sammuisi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer tidur tidak memutus suara — ia memudar perlahan. Dan karena tak ada yang menutup aplikasi setelah tertidur, suara tetap berjalan meski layar mati."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvntimeren kutter ikke lyden, den toner ut. Og siden ingen lukker en app etter at de har sovnet, fortsetter lyden også når skjermen er av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De slaaptimer kapt het geluid niet af, maar laat het wegsterven. En omdat niemand een app afsluit na het inslapen, speelt het geluid door als het scherm uit is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącznik czasowy nie urywa dźwięku, tylko powoli go wycisza. A ponieważ nikt nie zamyka aplikacji po zaśnięciu, dźwięk gra dalej także przy wyłączonym ekranie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovtimern klipper inte av ljudet – det tonar ut. Och eftersom ingen stänger en app när man har somnat fortsätter ljudet även med skärmen av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku zamanlayıcısı süre dolunca sesi aniden kesmez, yavaşça kısar. Uyuyan kimse uygulamayı kapatmayacağı için ekran kapansa da ses devam eder."
          }
        }
      }
    },
    "onboarding.p3.title" : {

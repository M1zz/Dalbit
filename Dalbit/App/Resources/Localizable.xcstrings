    "whats_new.moon.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can see its craters as it slowly turns and drifts across the night sky."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クレーターが見え、ゆっくり自転しながら夜空を漂います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분화구가 보이고, 아주 천천히 자전하며 밤하늘을 떠다녀요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can see its craters as it slowly turns and drifts across the night sky."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能看见环形山，还会非常缓慢地自转，漂浮在夜空中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看得見環形山，並且緩緩自轉，在夜空中漂浮。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видны кратеры: она медленно вращается и плывёт по ночному небу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ven sus cráteres mientras gira muy despacio y flota por el cielo nocturno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst seine Krater, während er sich langsam dreht und über den Nachthimmel schwebt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On y voit les cratères, et elle tourne lentement en flottant dans le ciel nocturne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vedono i crateri mentre ruota lentamente e fluttua nel cielo notturno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá para ver as crateras enquanto ela gira devagar e flutua pelo céu noturno."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มองเห็นหลุมบนผิวดวงจันทร์ ขณะที่หมุนช้า ๆ และล่องลอยไปบนท้องฟ้ายามค่ำคืน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ thấy các miệng hố khi mặt trăng chầm chậm xoay và trôi qua bầu trời đêm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidíte jeho krátery, jak se pomalu otáčí a pluje noční oblohou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan se dens kratere, mens den langsomt drejer og driver over nattehimlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βλέπετε τους κρατήρες του καθώς γυρίζει αργά και παρασύρεται στον νυχτερινό ουρανό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraatterit näkyvät, kun se pyörii hitaasti ja ajelehtii yötaivaalla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawahnya terlihat saat bulan berputar pelan dan melayang melintasi langit malam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser kraterne mens den langsomt roterer og driver over nattehimmelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet de kraters terwijl hij langzaam draait en over de nachthemel drijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widać na nim kratery, a on bardzo powoli się obraca i dryfuje po nocnym niebie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser kratrarna när den sakta snurrar och glider över natthimlen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraterleri görünüyor; çok yavaş dönerek gece gökyüzünde süzülüyor."
          }
        }
      }
    },

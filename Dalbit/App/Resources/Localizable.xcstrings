    "subscription.legal_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscription auto-renews after any free trial unless canceled at least 24 hours before the end of the current period. You can manage or cancel anytime in your App Store account settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは無料トライアル終了後に自動更新され、現在の期間が終了する24時間前までに解約しない限り更新されます。App Storeのアカウント設定からいつでも管理・解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 무료 체험 종료 후 자동 갱신되며, 현재 기간 종료 24시간 이전에 취소하지 않으면 갱신됩니다. App Store 계정 설정에서 언제든 관리·취소할 수 있습니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscription auto-renews after any free trial unless cancelled at least 24 hours before the end of the current period. You can manage or cancel anytime in your App Store account settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅将在免费试用结束后自动续订；如未在当前周期结束前至少 24 小时取消，则会自动续订。你可以随时在 App Store 账户设置中管理或取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱會在免費試用結束後自動續訂；若未在目前訂閱期間結束前至少 24 小時取消，就會自動續訂。你可以隨時在 App Store 帳號設定中管理或取消。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка автоматически продлевается после бесплатного периода, если не отменить её минимум за 24 часа до окончания текущего периода. Управлять подпиской и отменять её можно в любой момент в настройках учётной записи App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente tras la prueba gratuita, salvo que la canceles al menos 24 horas antes de que termine el periodo actual. Puedes gestionarla o cancelarla en cualquier momento en los ajustes de tu cuenta de App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Abo verlängert sich nach einer kostenlosen Testphase automatisch, sofern du nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums kündigst. Du kannst es jederzeit in den Einstellungen deines App-Store-Kontos verwalten oder kündigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abonnement se renouvelle automatiquement après l’essai gratuit éventuel, sauf annulation au moins 24 heures avant la fin de la période en cours. Vous pouvez le gérer ou l’annuler à tout moment dans les réglages de votre compte App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbonamento si rinnova automaticamente al termine di un’eventuale prova gratuita, a meno che non venga annullato almeno 24 ore prima della fine del periodo in corso. Puoi gestirlo o annullarlo in qualsiasi momento nelle impostazioni dell’account App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura é renovada automaticamente após o período de teste gratuito, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Você pode gerenciar ou cancelar a qualquer momento nos ajustes da sua conta da App Store."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสมัครสมาชิกจะต่ออายุอัตโนมัติหลังช่วงทดลองใช้ฟรี เว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน คุณจัดการหรือยกเลิกได้ทุกเมื่อในการตั้งค่าบัญชี App Store"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói đăng ký tự động gia hạn sau thời gian dùng thử miễn phí, trừ khi bạn hủy ít nhất 24 giờ trước khi kỳ hiện tại kết thúc. Bạn có thể quản lý hoặc hủy bất cứ lúc nào trong cài đặt tài khoản App Store."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předplatné se po skončení zkušebního období automaticky obnovuje, pokud ho nezrušíte alespoň 24 hodin před koncem aktuálního období. Spravovat nebo zrušit ho můžete kdykoli v nastavení účtu App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet fornyes automatisk efter en eventuel gratis prøveperiode, medmindre det opsiges mindst 24 timer før udgangen af den igangværende periode. Du kan til enhver tid administrere eller opsige det i indstillingerne for din App Store-konto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνδρομή ανανεώνεται αυτόματα μετά από οποιαδήποτε δωρεάν δοκιμή, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν από το τέλος της τρέχουσας περιόδου. Μπορείτε να τη διαχειριστείτε ή να την ακυρώσετε οποτεδήποτε στις ρυθμίσεις του λογαριασμού σας στο App Store."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaus uusiutuu automaattisesti ilmaisen kokeilun jälkeen, ellei sitä peruta vähintään 24 tuntia ennen nykyisen jakson päättymistä. Voit hallita tai perua tilauksen milloin tahansa App Store -tilisi asetuksissa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperpanjang otomatis setelah uji coba gratis apa pun, kecuali dibatalkan minimal 24 jam sebelum periode berjalan berakhir. Kamu bisa mengelola atau membatalkannya kapan saja di pengaturan akun App Store."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet fornyes automatisk etter en eventuell gratis prøveperiode, med mindre det sies opp minst 24 timer før den gjeldende perioden utløper. Du kan administrere eller si opp når som helst i App Store-kontoinnstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het abonnement wordt na een eventuele gratis proefperiode automatisch verlengd, tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Je kunt het op elk moment beheren of opzeggen in de instellingen van je App Store-account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcja odnawia się automatycznie po zakończeniu bezpłatnego okresu próbnego, o ile nie zostanie anulowana co najmniej 24 godziny przed końcem bieżącego okresu. Możesz nią zarządzać lub ją anulować w dowolnej chwili w ustawieniach konta App Store."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumerationen förnyas automatiskt efter en eventuell gratisperiod, om den inte sägs upp minst 24 timmar innan den aktuella perioden tar slut. Du kan när som helst hantera eller säga upp den i inställningarna för ditt App Store-konto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik, mevcut dönemin bitiminden en az 24 saat önce iptal edilmediği sürece ücretsiz deneme sonrasında otomatik olarak yenilenir. App Store hesap ayarlarınızdan istediğiniz zaman yönetebilir veya iptal edebilirsiniz."
          }
        }
      }
    },

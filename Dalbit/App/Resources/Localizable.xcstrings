    "stats.evidence_footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sleep sessions” counts nights when the timer ran to the end, or the app ended while playing for over 30 minutes. It's an estimate, not a sleep measurement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「入眠セッション」は、タイマーを最後まで使ったか、30分以上再生したままアプリが終了した場合です。睡眠を測定した値ではなく推定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘잠든 세션’은 타이머를 끝까지 두었거나, 30분 넘게 틀어 둔 채 앱이 끝난 경우예요. 수면을 측정한 값이 아니라 추정입니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sleep sessions” counts nights when the timer ran to the end, or the app ended while playing for over 30 minutes. It's an estimate, not a sleep measurement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“入睡会话”是指定时走完全程，或播放超过 30 分钟后应用结束的情况。这是估算，并非实际测量的睡眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「睡著的工作階段」是指計時器跑到最後，或播放超過 30 分鐘後 App 結束的情況。這是推估值，並非實際測量的睡眠數據。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сеансы со сном» — это когда таймер дошёл до конца или приложение закрылось после 30+ минут воспроизведения. Это оценка, а не измерение сна."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las «sesiones dormidas» son noches en que el temporizador llegó al final o la app se cerró tras más de 30 minutos de reproducción. Es una estimación, no una medición del sueño."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Schlaf-Sitzungen“ zählt Nächte, in denen der Timer bis zum Ende lief oder die App während einer Wiedergabe von über 30 Minuten beendet wurde. Das ist eine Schätzung, keine Schlafmessung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Sessions endormies » compte les nuits où le minuteur est allé au bout, ou où l’app s’est fermée après plus de 30 minutes de lecture. C’est une estimation, pas une mesure du sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le “sessioni di sonno” sono le notti in cui il timer è arrivato alla fine, o l’app si è chiusa dopo più di 30 minuti di riproduzione. È una stima, non una misurazione del sonno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sessões com sono” conta as noites em que o timer foi até o fim ou o app foi encerrado após mais de 30 minutos de reprodução. É uma estimativa, não uma medição do sono."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“เซสชันที่หลับ” คือคืนที่ตัวตั้งเวลาทำงานจนจบ หรือแอปปิดไประหว่างเล่นนานเกิน 30 นาที เป็นค่าประมาณ ไม่ใช่ค่าที่วัดการนอน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Phiên ngủ” tính những đêm hẹn giờ chạy đến hết, hoặc ứng dụng kết thúc khi đang phát hơn 30 phút. Đây là ước tính, không phải số liệu đo giấc ngủ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Relace s usnutím“ jsou noci, kdy časovač doběhl do konce, nebo se aplikace ukončila při přehrávání delším než 30 minut. Jde o odhad, ne o měření spánku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Søvnsessioner” tæller nætter, hvor timeren løb helt ud, eller appen blev afsluttet, mens den havde spillet i over 30 minutter. Det er et skøn, ikke en søvnmåling."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι «συνεδρίες ύπνου» μετρούν τις νύχτες που το χρονόμετρο έτρεξε μέχρι το τέλος ή η εφαρμογή έκλεισε ενώ έπαιζε πάνω από 30 λεπτά. Είναι εκτίμηση, όχι μέτρηση του ύπνου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Nukahtaneet istunnot” tarkoittavat öitä, jolloin ajastin kävi loppuun tai sovellus sulkeutui yli 30 minuutin toiston jälkeen. Se on arvio, ei unen mittaus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sesi tidur” menghitung malam saat timer berjalan sampai selesai, atau aplikasi berakhir saat memutar lebih dari 30 menit. Ini perkiraan, bukan pengukuran tidur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Søvnøkter» teller netter der timeren gikk helt ut, eller appen ble avsluttet mens lyden hadde spilt i over 30 minutter. Det er et anslag, ikke en søvnmåling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij “Slaapsessies” tellen nachten waarin de timer helemaal afliep of de app tijdens het afspelen langer dan 30 minuten werd afgesloten. Het is een schatting, geen slaapmeting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sesje ze snem” to noce, gdy timer dotrwał do końca albo aplikacja zakończyła działanie po ponad 30 minutach odtwarzania. To szacunek, a nie pomiar snu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Sömnsessioner” räknar nätter då timern gick till slutet, eller då appen avslutades under uppspelning efter över 30 minuter. Det är en uppskattning, inte en sömnmätning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uyku oturumları”, zamanlayıcının sonuna kadar çalıştığı ya da ses 30 dakikadan uzun süre çalarken uygulamanın kapandığı geceleri sayar. Bu bir uyku ölçümü değil, tahmindir."
          }
        }
      }
    },

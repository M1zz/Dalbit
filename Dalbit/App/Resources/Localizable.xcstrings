    "signal.avg_streak_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether it became a habit. Near 1 means people use it once and stop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "習慣になったかどうか。1に近いと、1日使って終わりということです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "습관이 됐는지. 1에 가까우면 하루 쓰고 마는 거예요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether it became a habit. Near 1 means people use it once and stop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否养成了习惯。接近 1 说明用一天就不用了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看是否養成習慣。越接近 1，代表用一天就不用了。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стало ли это привычкой. Значение около 1 — попользовались день и бросили."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se ha vuelto un hábito. Cerca de 1 significa que se usa un día y se deja."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob es zur Gewohnheit wurde. Nahe 1 heißt: einen Tag genutzt und wieder aufgehört."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Est-ce devenu une habitude ? Proche de 1, on l’utilise un jour puis on arrête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è diventata un’abitudine. Vicino a 1 significa che si usa un giorno e poi basta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se virou hábito. Perto de 1 significa que a pessoa usa uma vez e para."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูว่าเป็นนิสัยหรือยัง ถ้าใกล้ 1 แปลว่าใช้วันเดียวแล้วเลิก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho biết đã thành thói quen chưa. Gần 1 nghĩa là dùng một ngày rồi bỏ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jestli se z toho stal zvyk. Blízko 1 znamená, že lidé zkusí jednou a přestanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det blev en vane. Tæt på 1 betyder, at folk bruger den én gang og stopper."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν έγινε συνήθεια. Κοντά στο 1 σημαίνει ότι οι άνθρωποι το χρησιμοποιούν μία φορά και σταματούν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko tullut tapa. Lähellä ykköstä tarkoittaa, että käytetään yksi päivä ja lopetetaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah sudah jadi kebiasaan. Mendekati 1 berarti orang memakainya sekali lalu berhenti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det ble en vane. Nær 1 betyr at folk bruker den én dag og slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of het een gewoonte werd. Dichtbij 1 betekent dat mensen het één keer gebruiken en stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy weszło w nawyk. Blisko 1 oznacza, że ktoś używa raz i przestaje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det blev en vana. Nära 1 betyder att folk använder den en gång och slutar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alışkanlığa dönüşüp dönüşmediği. 1'e yakınsa insanlar bir gün kullanıp bırakıyor demektir."
          }
        }
      }
    },

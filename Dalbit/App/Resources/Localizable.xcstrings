    "whats_new.contact.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send an email or write an App Store review from Settings. You can also redeem App Store offer codes on the subscription screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定からメールを送ったり、App Storeにレビューを書いたりできます。サブスクリプション画面ではApp Storeのオファーコードも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 메일을 보내거나 App Store 리뷰를 남길 수 있어요. 구독 화면에서는 App Store 오퍼 코드도 쓸 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send an email or write an App Store review from Settings. You can also redeem App Store offer codes on the subscription screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以在设置中发送邮件，或写 App Store 评价。在订阅页面还能兑换 App Store 优惠码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以在設定中寄信，或到 App Store 留下評論。在訂閱畫面也能兌換 App Store 優惠代碼。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из настроек можно написать на почту или оставить отзыв в App Store. На экране подписки теперь можно ввести и промокод App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde Ajustes puedes enviar un correo o escribir una reseña en el App Store. En la pantalla de suscripción también puedes canjear códigos de oferta del App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib uns in den Einstellungen eine E-Mail oder eine Bewertung im App Store. Auf dem Abo-Bildschirm kannst du auch App-Store-Angebotscodes einlösen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un e-mail ou laissez un avis App Store depuis les Réglages. Vous pouvez aussi utiliser un code d’offre App Store sur l’écran d’abonnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Impostazioni puoi scrivere un’email o lasciare una recensione sull’App Store. Nella schermata dell’abbonamento puoi anche usare i codici offerta dell’App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie um e-mail ou escreva uma avaliação na App Store pelos Ajustes. Na tela de assinatura, você também pode resgatar códigos de oferta da App Store."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งอีเมลหรือเขียนรีวิว App Store ได้จากการตั้งค่า และที่หน้าสมัครสมาชิกยังใช้โค้ดข้อเสนอ App Store ได้ด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể gửi email hoặc viết đánh giá trên App Store ngay trong Cài đặt. Ở màn hình đăng ký, bạn cũng dùng được mã ưu đãi của App Store."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Nastavení můžete poslat e-mail nebo napsat recenzi do App Store. Na obrazovce předplatného lze také uplatnit kódy nabídek z App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send en mail eller skriv en anmeldelse i App Store fra Indstillinger. På abonnementsskærmen kan du også indløse tilbudskoder fra App Store."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλτε email ή γράψτε κριτική στο App Store από τις Ρυθμίσεις. Στην οθόνη συνδρομής μπορείτε επίσης να εξαργυρώσετε κωδικούς προσφοράς του App Store."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit lähettää sähköpostia tai kirjoittaa App Store -arvostelun asetuksista. Tilausnäkymässä voi myös lunastaa App Storen tarjouskoodeja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim email atau tulis ulasan App Store dari Pengaturan. Kamu juga bisa menukar kode penawaran App Store di layar langganan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send en e-post eller skriv en anmeldelse i App Store fra Innstillinger. På abonnementsskjermen kan du også løse inn tilbudskoder fra App Store."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur een e-mail of schrijf een App Store-recensie vanuit Instellingen. Op het abonnementsscherm kun je ook App Store-aanbiedingscodes inwisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Ustawieniach możesz wysłać e-mail albo napisać recenzję w App Store. Na ekranie subskrypcji zrealizujesz też kody ofert z App Store."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka ett mejl eller skriv en recension i App Store från Inställningar. På prenumerationsskärmen kan du också lösa in erbjudandekoder från App Store."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar'dan e-posta gönderebilir ya da App Store'da yorum yazabilirsiniz. Abonelik ekranında App Store teklif kodlarını da kullanabilirsiniz."
          }
        }
      }
    },

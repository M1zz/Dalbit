    "whats_new.dim.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fades gently so it won’t glare while you fall asleep, and brightens again at a touch. You can turn it off under Display in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠りにつくあいだまぶしくないよう少しずつ暗くなり、触れると元に戻ります。設定の「画面」でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠드는 동안 눈부시지 않게 서서히 어두워지고, 만지면 다시 밝아져요. 설정의 화면에서 끌 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fades gently so it won’t glare while you fall asleep, and brightens again at a touch. You can turn it off under Display in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入睡时屏幕会慢慢变暗，不再刺眼，一碰又会亮起。可以在设置的“显示”中关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入睡時會慢慢變暗，不會刺眼，碰一下又會恢復明亮。可在設定的「顯示」中關閉。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он плавно гаснет, чтобы не слепить, пока вы засыпаете, и снова светлеет от касания. Отключить можно в «Настройки» → «Экран»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se oscurece poco a poco para no deslumbrarte mientras te duermes y vuelve a iluminarse al tocarla. Puedes desactivarlo en Pantalla, dentro de Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird sanft dunkler, damit er beim Einschlafen nicht blendet, und bei Berührung wieder heller. In den Einstellungen unter „Anzeige“ lässt es sich ausschalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il baisse en douceur pour ne pas éblouir pendant que vous vous endormez, et se rallume au toucher. Désactivable dans Réglages, sous Affichage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfuma piano per non abbagliarti mentre ti addormenti e torna luminoso al tocco. Puoi disattivarlo in Impostazioni, sotto Schermo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela escurece aos poucos para não ofuscar enquanto você pega no sono e volta a clarear ao toque. Dá para desativar em Tela, nos Ajustes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจอค่อย ๆ หรี่ลงไม่ให้แสบตาตอนกำลังหลับ และสว่างขึ้นอีกครั้งเมื่อสัมผัส ปิดได้ที่การแสดงผลในการตั้งค่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình mờ dần để không chói mắt lúc bạn thiếp đi, và sáng lại khi bạn chạm vào. Bạn có thể tắt trong Màn hình ở Cài đặt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvolna ztmavne, aby vás při usínání nerušil, a dotykem se opět rozjasní. Vypnout ho můžete v Nastavení v části Displej."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den toner blidt ned, så den ikke blænder, mens du falder i søvn, og bliver lys igen, når du rører den. Du kan slå det fra under Skærm i Indstillinger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σβήνει απαλά ώστε να μην θαμπώνει καθώς αποκοιμιέστε και φωτίζει ξανά με ένα άγγιγμα. Μπορείτε να το απενεργοποιήσετε στις Ρυθμίσεις, στην ενότητα Οθόνη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se himmenee hiljalleen, ettei häikäise nukahtaessasi, ja kirkastuu taas kosketuksesta. Asetusten Näyttö-osiossa sen voi poistaa käytöstä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar memudar lembut agar tidak menyilaukan saat kamu terlelap, dan terang lagi saat disentuh. Bisa dimatikan di Tampilan pada Pengaturan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den toner sakte ned så den ikke blender mens du sovner, og blir lys igjen når du berører den. Du kan slå det av under Skjerm i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het dimt rustig, zodat het niet verblindt terwijl je indommelt, en wordt bij aanraking weer helder. Je kunt dit uitzetten onder Weergave in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciemnia się powoli, żeby nie raził podczas zasypiania, a po dotknięciu znów się rozjaśnia. Wyłączysz to w Ustawieniach, w sekcji Ekran."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tonas ner sakta så att den inte bländar när du somnar, och lyser upp igen vid en beröring. Du kan stänga av det under Skärm i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykuya dalarken gözünüzü almasın diye yavaşça kararır, dokunduğunuzda yeniden aydınlanır. Ayarlar'daki Ekran bölümünden kapatabilirsiniz."
          }
        }
      }
    },

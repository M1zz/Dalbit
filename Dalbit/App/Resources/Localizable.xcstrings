    "signal.made_own_mix_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share who reached the core value. Low means the maker screen is too hard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コアバリューに到達した割合。低ければ作成画面が難しいということです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핵심 가치에 도달한 비율. 낮으면 제작 화면이 어렵다는 뜻이에요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share who reached the core value. Low means the maker screen is too hard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体验到核心价值的占比。偏低说明制作界面太难。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "體驗到核心價值的比例。偏低代表製作畫面太難。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля тех, кто дошёл до главной ценности. Низкая — экран создания слишком сложен."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes llegaron al valor principal. Si es bajo, la pantalla de creación es demasiado difícil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil, der den Kernnutzen erreicht. Niedrig heißt, der Editor ist zu schwer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part de ceux qui atteignent la valeur clé. Si elle est basse, l’écran de création est trop difficile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quota di chi ha raggiunto il valore chiave. Se è bassa, la schermata di creazione è troppo difficile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcela que chegou ao valor central. Baixa indica que a tela de criação está difícil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัดส่วนคนที่ถึงคุณค่าหลัก ถ้าต่ำแปลว่าหน้าสร้างเสียงยากไป"
          }
        },
        "vi" : {
          "stringUnit" : {

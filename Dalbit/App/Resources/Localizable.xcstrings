    "roadmap.lang_more.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Dalbit in more languages, not just Korean and English."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国語と英語のほかにも、もっと多くの言語で使えるようにします。"

    "tip.favorite_longpress.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold for about a second to favorite the sound you're hearing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1秒ほど長押しすると、いま聴いているサウンドがお気に入りに追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1초쯤 길게 누르면 지금 듣는 소리가 즐겨찾기에 담겨요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold for about a second to favourite the sound you're hearing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按约 1 秒，就能把正在听的声音加入收藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按約 1 秒，就能把正在聽的聲音加入我的最愛。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте около секунды — текущий звук добавится в избранное."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un segundo para añadir a favoritos el sonido que estás oyendo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte etwa eine Sekunde gedrückt, um den aktuellen Sound zu den Favoriten hinzuzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt environ une seconde pour ajouter le son en cours aux favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto per circa un secondo per aggiungere ai preferiti il suono che stai ascoltando."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado por cerca de um segundo para favoritar o som que está tocando."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างราว 1 วินาที เสียงที่กำลังฟังจะถูกเพิ่มในรายการโปรด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ khoảng một giây để thêm âm thanh đang nghe vào yêu thích."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte asi vteřinu a zvuk, který právě slyšíte, se přidá do oblíbených."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede i omkring ét sekund for at gemme den lyd, du hører, som favorit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένο για περίπου ένα δευτερόλεπτο για να βάλετε στα αγαπημένα τον ήχο που ακούτε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina noin sekunti, niin kuuntelemasi ääni lisätään suosikkeihin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan sekitar satu detik untuk memfavoritkan suara yang sedang kamu dengar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne i omtrent ett sekund for å legge lyden du hører, til i favoritter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ongeveer een seconde vast om het geluid dat je hoort als favoriet te markeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj przez około sekundę, aby dodać aktualny dźwięk do ulubionych."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll nere i ungefär en sekund för att göra ljudet du hör till en favorit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık bir saniye basılı tutarsanız çalan ses favorilere eklenir."
          }
        }
      }
    },

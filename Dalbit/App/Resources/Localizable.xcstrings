          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把设备语言设为简体中文，Dalbit 也会跟着显示中文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把裝置語言設為日文，Dalbit 也會跟著顯示日文。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите на устройстве русский язык — и Dalbit заговорит по-русски."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon tu dispositivo en japonés y Dalbit se mostrará en japonés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dein Gerät auf Japanisch, und Dalbit folgt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez votre appareil en japonais, et Dalbit suit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta il dispositivo in italiano e anche Dalbit si adegua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o idioma do aparelho em português e o Dalbit acompanha."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งภาษาของเครื่องเป็นภาษาไทย Dalbit ก็จะเป็นภาษาไทยตาม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ngôn ngữ thiết bị là tiếng Nhật, Dalbit sẽ hiển thị bằng tiếng Nhật."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte v zařízení japonštinu a Dalbit se přepne s ním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt din enhed til dansk, så følger Dalbit med."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίστε τη συσκευή σας στα ιαπωνικά και το Dalbit ακολουθεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta laitteen kieleksi suomi, niin Dalbit seuraa perässä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur perangkatmu ke bahasa Indonesia dan Dalbit akan mengikuti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett enheten til japansk, så følger Dalbit etter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je toestel op Nederlands en Dalbit volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw język urządzenia na japoński, a Dalbit pójdzie w jego ślady."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in enheten på svenska så följer Dalbit med."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz dilini Türkçe yaparsanız Dalbit da Türkçe görünür."
          }
        }
      }
    },
